#!/usr/bin/env bash
# Convert a Spec Kit tasks.md into a plan subagent-driven-development can
# execute: one "### Task N" per tasks.md section that still has unchecked task
# lines, with the phase's text copied verbatim. tasks.md stays the source of
# truth — implementers tick its checkboxes as they finish each line.
#
# Usage: speckit-plan-from-tasks FEATURE_DIR [OUTFILE]
# Default OUTFILE: FEATURE_DIR/pipeline-plan.md
# FEATURE_DIR/pipeline-constraints.md, if present, is appended to Global Constraints.
# FEATURE_DIR/pipeline-split.md, if present, splits large phases (see below).
# Exit: 0 written, 2 usage/missing files, 3 no unchecked tasks left,
#       4 unchecked task lines outside any section, 5 malformed split.
set -euo pipefail

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
  echo "usage: speckit-plan-from-tasks FEATURE_DIR [OUTFILE]" >&2
  exit 2
fi

feature_dir=${1%/}
[ -d "$feature_dir" ] || { echo "no such feature directory: $feature_dir" >&2; exit 2; }
tasks="$feature_dir/tasks.md"
[ -f "$tasks" ] || { echo "no tasks.md in $feature_dir — run speckit-tasks first" >&2; exit 2; }
[ -f "$feature_dir/spec.md" ] || { echo "no spec.md in $feature_dir" >&2; exit 2; }
out=${2:-"$feature_dir/pipeline-plan.md"}

# Paths in the plan are repo-relative so they read the same from any worktree.
repo=$(git -C "$feature_dir" rev-parse --show-toplevel 2>/dev/null) || {
  echo "feature directory is not inside a git repository: $feature_dir" >&2
  exit 2
}
abs_dir=$(cd "$feature_dir" && pwd -P)
repo=$(cd "$repo" && pwd -P)
rel_dir=${abs_dir#"$repo"/}

design=""
for f in plan.md research.md data-model.md contracts quickstart.md; do
  [ -e "$feature_dir/$f" ] && design="$design${design:+, }$rel_dir/$f"
done
# An unfilled constitution (still the template) binds nothing. Spec Kit
# records the template's hash in .constitution-template.json.
constitution="none"
c="$repo/.specify/memory/constitution.md"
if [ -f "$c" ]; then
  constitution=".specify/memory/constitution.md"
  # Placeholders count only outside HTML comments: speckit-constitution's own
  # Sync Impact Report comment lists the old placeholder names it replaced.
  if awk '/<!--/{c=1} !c{print} /-->/{c=0}' "$c" | grep -qE '\[(PROJECT_NAME|PRINCIPLE_1_NAME)\]'; then
    constitution="none"
  elif [ -f "$repo/.specify/memory/.constitution-template.json" ]; then
    template_sha=$(sed -n 's/.*"sha256": *"\([0-9a-f]*\)".*/\1/p' "$repo/.specify/memory/.constitution-template.json")
    if command -v shasum >/dev/null 2>&1; then
      sha=$(shasum -a 256 "$c" | cut -d' ' -f1)
    else
      sha=$(sha256sum "$c" | cut -d' ' -f1)
    fi
    [ -n "$template_sha" ] && [ "$sha" = "$template_sha" ] && constitution="none"
  fi
fi

body=$(mktemp)
trap 'rm -f "$body"' EXIT

split="$feature_dir/pipeline-split.md"
[ -f "$split" ] || split=""

# Every level-2 section (outside code fences) that still has an unchecked
# task line becomes one task: "## Phase 3: ...", "## Phase N: Polish",
# "## Final Phase", "## Phase 10: Convergence" alike. A task is identified by
# the first Spec Kit task ID in it ("### Task T008"). Spec Kit never renumbers
# task IDs, so a task keeps its ID when the plan is regenerated —
# subagent-driven-development's ledger records progress by task ID and must
# never see one ID mean two tasks.
#
# pipeline-split.md, if present, splits large phases. Each line
# "T040: T040 T046 T047  # comment" is one group, keyed by its first task in
# tasks.md order. A section that has any task in a group is split: each
# group becomes its own task carrying the section's prose (goal, checkpoint,
# subheadings) plus only its own task lines; every task line in that section
# must belong to exactly one group.
#
# Task lines may be indented or carry a bold ID. Deeper headings are demoted
# one level so they sit under the generated "### Task" heading. Nothing is
# dropped silently: an unchecked task line outside any section exits 4, a
# malformed split exits 5.
awk -v tasks_rel="$rel_dir/tasks.md" -v splitfile="$split" '
  function err(msg) { print "split error: " msg > "/dev/stderr"; errs++ }
  function taskid(s) { match(s, /T[0-9]+/); return substr(s, RSTART, RLENGTH) }
  function header(id, t) {
    n++
    printf "### Task %s: %s\n\n", id, t
    print "Implement every unchecked Spec Kit task line below, in order, honoring"
    print "\"depends on\" notes; `[P]` lines touch independent files. Lines already"
    print "marked `[X]` are done. When a line is finished, change its `- [ ]` to"
    print "`- [X]` in " tasks_rel " in the same commit as the work. Test-first"
    print "red/green checks are yours: run them, record the output in your report,"
    print "and tick them. Only a line that needs a live or shared environment, a"
    print "full-suite run, or a manual walkthrough goes to QA: leave it unchecked"
    print "and say so in your report.\n"
  }
  function flush(   i, j, g, id, is_split, ng, k) {
    if (!insec) { nl = 0; return }
    is_split = 0
    for (i = 1; i <= nl; i++) if (T[i] && (I[i] in group_of)) is_split = 1
    if (!is_split) {
      if (open > 0) {
        header(first, title)
        for (i = 1; i <= nl; i++) print L[i]
        print ""
      }
    } else {
      ng = 0
      for (k in gopen) delete gopen[k]
      for (i = 1; i <= nl; i++) {
        if (!T[i]) continue
        id = I[i]
        if (!(id in group_of)) { err("phase \"" title "\" is split but " id " is in no group"); continue }
        g = group_of[id]
        found[id] = 1
        if (!(g in gopen)) {
          if (g in done) err("group " g " spans more than one phase (" id " is in \"" title "\")")
          if (g != id) err("group " g " must be keyed by its first task in tasks.md order, " id)
          gopen[g] = 0; order[++ng] = g
        }
        if (O[i]) gopen[g]++
      }
      for (j = 1; j <= ng; j++) {
        g = order[j]; done[g] = 1
        if (gopen[g] == 0) continue
        header(g, title " — part " j " of " ng)
        for (i = 1; i <= nl; i++) if (!T[i] || ((I[i] in group_of) && group_of[I[i]] == g)) print L[i]
        print ""
      }
    }
    insec = 0; nl = 0; open = 0; first = ""
  }
  BEGIN {
    if (splitfile != "") {
      while ((getline line < splitfile) > 0) {
        sub(/#.*/, "", line)
        if (line !~ /^[ \t]*T[0-9]+[ \t]*:/) continue
        key = taskid(line)
        rest = substr(line, index(line, ":") + 1)
        nm = split(rest, f, /[ \t,]+/)
        haskey = 0
        for (m = 1; m <= nm; m++) {
          if (f[m] !~ /^T[0-9]+$/) continue
          if (f[m] in group_of) err(f[m] " is in two groups (" group_of[f[m]] " and " key ")")
          group_of[f[m]] = key
          if (f[m] == key) haskey = 1
        }
        if (!haskey) err("group " key " does not list " key " itself as a member")
      }
      close(splitfile)
    }
  }
  /^[ \t]*```/ { infence = !infence }
  !infence && /^## / { flush(); insec = 1; title = substr($0, 4); next }
  {
    istask = !infence && $0 ~ /^[ \t]*[-*] \[[ xX]\] (\*\*)?T[0-9]+/
    isopen = !infence && $0 ~ /^[ \t]*[-*] \[ \] (\*\*)?T[0-9]+/
    if (isopen && !insec) { stray++; print "stray task line outside any section: " $0 > "/dev/stderr" }
    if (!insec) next
    line = $0
    if (!infence && line ~ /^###/) line = "#" line
    nl++; L[nl] = line; T[nl] = istask; O[nl] = isopen; I[nl] = istask ? taskid(line) : ""
    if (istask && first == "") first = I[nl]
    if (isopen) open++
  }
  END {
    flush()
    for (m in group_of) if (!(m in found)) err(m " is in a group but not in tasks.md")
    if (stray) exit 4
    if (errs) exit 5
    if (!n) exit 3
  }
' "$tasks" > "$body" || {
  rc=$?
  if [ "$rc" -eq 3 ]; then
    echo "no unchecked task lines in $tasks — nothing left to build" >&2
  fi
  exit "$rc"
}

title=$(sed -n 's/^# Tasks: //p' "$tasks" | head -n 1)
[ -n "$title" ] || title=$(basename "$abs_dir")

{
  echo "# $title — Pipeline Implementation Plan"
  echo
  echo "> Generated from $rel_dir/tasks.md by superpowers:feature-pipeline."
  echo "> tasks.md is the source of truth: regenerate this file, never edit task text here."
  echo
  echo "**Spec:** $rel_dir/spec.md"
  echo "**Design:** ${design:-none}"
  echo "**Constitution:** $constitution"
  echo
  echo "## Global Constraints"
  echo
  echo "- Requirements are spec.md's FR-NNN items, each user story's acceptance"
  echo "  scenarios, and its SC-NNN success criteria. All are binding."
  echo "- The design files above are binding: plan.md's stack and structure,"
  echo "  data-model.md's entities, and contracts/ interfaces exactly as written."
  echo "- The build commits each task's work, which overrides any \"do not commit\""
  echo "  instruction in tasks.md."
  echo "- Run only the formatters and linters the repo already configures, and"
  echo "  keep build output, caches, and local state out of git (extend .gitignore"
  echo "  in the task that first produces them)."
  if [ "$constitution" != "none" ]; then
    echo "- Every MUST principle in the constitution binds every task."
  fi
  # Constraints the pipeline controller adds live in their own file so that
  # regenerating this plan never drops them.
  if [ -f "$feature_dir/pipeline-constraints.md" ]; then
    cat "$feature_dir/pipeline-constraints.md"
  fi
  echo
  cat "$body"
} > "$out"

echo "wrote $out: $(grep -c '^### Task ' "$out") tasks"
